# font
font-family = "JetBrainsMono Nerd Font Mono"
font-family = termicons
macos-option-as-alt = left
font-size = 15
font-feature = zero, liga, calt
adjust-cell-height = 35%
window-width = 350
window-height = 125

window-save-state = never

# Theme
theme = Rose Pine Moon

cursor-style = block

# keybindings (sintassi: keybind = <trigger>=<azione>)
keybind = cmd+shift+t=new_tab
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+w=close_surface
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

quick-terminal-position = top
quick-terminal-autohide = true
keybind = global:cmd+grave_accent=toggle_quick_terminal

clipboard-read = allow
clipboard-write = allow
copy-on-select = true

scrollback-limit = 10000000

background-opacity = 0.95
background-blur = 20

# performance
window-vsync = true
shell-integration = fish
shell-integration-features = no-cursor

# laggy issue
macos-secure-input-indication = false
